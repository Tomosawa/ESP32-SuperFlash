; Inno Setup script for ESP32 SuperFlash (Windows x64).
; Stage, Root, Version and IconFile are supplied by scripts/package-windows.ps1:
;   ISCC.exe /DStage=<payload dir> /DRoot=<repo root> /DVersion=<x.y.z> /DIconFile=<icon file> \
;           /O<output dir> /F<output base name> scripts/installer.iss

#ifndef AppName
  #define AppName "ESP32 SuperFlash"
#endif
#ifndef Version
  #define Version "0.0.0"
#endif
#ifndef Stage
  #define Stage "..\dist\payload"
#endif
#ifndef Root
  #define Root ".."
#endif
#ifndef IconFile
  #error "IconFile must point to the ICO generated by package-windows.ps1."
#endif

[Setup]
AppId={{8F3A1C42-6D7E-4B91-9C2A-5E7D0B4A1F36}
AppName={#AppName}
AppVersion={#Version}
AppVerName={#AppName} {#Version}
AppPublisher=tomosawa
AppPublisherURL=https://github.com/tomosawa/esp32-superflash
AppSupportURL=https://github.com/tomosawa/esp32-superflash/issues
AppUpdatesURL=https://github.com/tomosawa/esp32-superflash/releases
DefaultDirName={autopf}\{#AppName}
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
LicenseFile={#Root}\LICENSE
SetupIconFile={#IconFile}
UninstallDisplayIcon={app}\icon.ico
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
ShowLanguageDialog=yes

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "{#Root}\scripts\languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "{#Stage}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#IconFile}"; DestDir: "{app}"; DestName: "icon.ico"; Flags: ignoreversion

[Icons]
Name: "{group}\{#AppName}"; Filename: "{app}\ESP32-SuperFlash.exe"; IconFilename: "{app}\icon.ico"
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\ESP32-SuperFlash.exe"; IconFilename: "{app}\icon.ico"; Tasks: desktopicon
Name: "{group}\{cm:UninstallProgram,{#AppName}}"; Filename: "{uninstallexe}"

[Run]
Filename: "{app}\ESP32-SuperFlash.exe"; Description: "{cm:LaunchProgram,{#AppName}}"; Flags: nowait postinstall skipifsilent
